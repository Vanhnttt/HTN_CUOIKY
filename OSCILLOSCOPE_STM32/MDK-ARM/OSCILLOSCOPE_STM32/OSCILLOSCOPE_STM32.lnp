--strict --scatter "OSCILLOSCOPE_STM32\OSCILLOSCOPE_STM32.sct"
--summary_stderr --info summarysizes --map --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "OSCILLOSCOPE_STM32.map" -o OSCILLOSCOPE_STM32\OSCILLOSCOPE_STM32.axf